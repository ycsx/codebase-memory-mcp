# Remote MCP server configuration. Copy to a local .env or install as a
# systemd EnvironmentFile; never commit the populated file.
CBM_MCP_BIND=0.0.0.0
CBM_MCP_PORT=9766
CBM_MCP_AUTH_TOKEN=replace-with-at-least-32-random-bytes
CBM_MCP_AUDIT_LOG=/var/log/codebase-memory-mcp/audit.jsonl
CBM_CACHE_DIR=/var/lib/codebase-memory-mcp

# Only list proxies that overwrite X-Forwarded-For. Leave empty for direct
# connections so the server always audits the socket peer address.
CBM_MCP_TRUSTED_PROXIES=

CBM_MCP_SESSION_TTL_SEC=1800
CBM_MCP_MAX_SESSIONS=64
CBM_MCP_MAX_WORKERS=16
